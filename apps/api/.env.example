# ==============================================================================
# CHIDI AI — Backend API Environment Configuration Example (.env.example)
# DO NOT COMMIT SECRETS OR LIVE CREDENTIALS TO SOURCE CONTROL
# ==============================================================================

# Application & Environment
PROJECT_NAME="CHIDI AI"
API_V1_STR="/api/v1"
ENVIRONMENT="production"  # Options: "development", "staging", "production"

# Security & Authentication
# Generate a secure 32+ character key using `openssl rand -hex 32`
SECRET_KEY="replace_with_a_secure_cryptographic_random_secret_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database Configuration (PostgreSQL with asyncpg)
# Either specify DATABASE_URL or the individual POSTGRES_* parameters
DATABASE_URL="postgresql://chidi_user:chidi_secure_password@localhost:5432/chidi_prod?sslmode=require"
POSTGRES_USER="chidi_user"
POSTGRES_PASSWORD="chidi_secure_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="chidi_prod"

# AI Provider Credentials
GEMINI_API_KEY="your_google_gemini_api_key_here"

# WhatsApp Cloud API (Meta Business Platform)
# Required in production: Meta App Secret for HMAC-SHA256 signature verification
WHATSAPP_APP_SECRET="your_meta_app_secret_here"
# Configured webhook verification token (must match Meta App Dashboard)
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verify_token_here"

# CORS Configuration
# Comma-separated list of trusted origins allowed to access authenticated API
CORS_ORIGINS="https://chidi-ai.com,https://app.chidi-ai.com,https://storefront.chidi-ai.com"

# Optional: Redis Cache & Event Bus (Upstash or Managed Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
